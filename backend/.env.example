# —— 服务 ——
PORT=8897
ALLOWED_ORIGINS=http://localhost:5179,http://127.0.0.1:5179,http://localhost:8080,http://127.0.0.1:8080
ALLOW_PRIVATE_URLS=false

# —— JWT ——
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300