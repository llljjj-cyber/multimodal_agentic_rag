# —— 本地 Embedding（BGE-M3）——
BGE_MODEL_PATH=/models/bge-m3
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# —— 评测（可选）——
RAGAS_API_KEY=
RAGAS_BASE_URL=
